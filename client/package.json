{
  "name": "hearth",
  "productName": "Hearth",
  "version": "0.9.5",
  "description": "Self-hosted voice, camera, screen-share, and chat hangout for your crew",
  "homepage": "https://github.com/silkhelp-wq/hearth",
  "license": "MIT",
  "private": true,
  "author": "Mages of the Beaches LLC <silkhelp-wq@users.noreply.github.com>",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "mediasoup-client": "^3.21.0",
    "socket.io-client": "^4.8.3"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "io.magesofthebeaches.hearth",
    "npmRebuild": false,
    "productName": "Hearth",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Network",
      "maintainer": "Mages of the Beaches LLC",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": true,
      "runAfterFinish": true,
      "license": "build/installer-notes.txt"
    },
    "extraResources": [
      {
        "from": "build/update-token.txt",
        "to": "update-token.txt",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "silkhelp-wq",
        "repo": "hearth",
        "private": true,
        "releaseType": "release"
      }
    ],
    "deb": {
      "afterRemove": "build/deb-after-remove.sh"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "dmg": {
      "contents": [
        {
          "x": 140,
          "y": 160
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 300,
          "type": "file",
          "path": "build/READ ME FIRST.txt"
        }
      ]
    }
  }
}